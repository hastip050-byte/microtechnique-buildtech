const $=s=>document.querySelector(s), app=$('#app');let me=null;const money=n=>'₹'+Number(n||0).toLocaleString('en-IN');const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function api(url,opts={}){const r=await fetch(url,{credentials:'same-origin',headers:{'Content-Type':'application/json',...(opts.headers||{})},...opts});let d={};try{d=await r.json()}catch{}if(!r.ok)throw Error(d.error||'Request failed');return d}function toast(t){const e=$('#toast');e.textContent=t;e.style.display='block';setTimeout(()=>e.style.display='none',3200)}
const links=[['Buy','/buy'],['Rent','/rent'],['New Projects','/new-projects'],['Commercial','/commercial'],['Plot & Land','/plots'],['Home Loans','/home-loans'],['Services','/services']];
function header(){return `<div class="topline">INDIA-WIDE PROPERTY DISCOVERY • SMART REAL ESTATE SOLUTIONS</div><header class="header"><a class="brand" href="/"><span class="logo">MB</span><span><b>MICROTECHNIQUE<br>BUILDTECH</b><small>SMART REAL ESTATE SOLUTIONS</small></span></a><nav class="nav">${links.map(([n,u])=>`<a href="${u}" class="${location.pathname===u?'active':''}">${n}</a>`).join('')}</nav><div class="actions">${me?`<a class="btn light" href="/dashboard">${esc(me.name.split(' ')[0])}</a><button class="secondary" onclick="logout()">Logout</button>`:`<a class="btn light" href="/login">Login</a><a class="btn" href="/register">Sign Up</a>`}</div></header>`}
function footer(){return `<footer class="footer"><div class="brand"><span class="logo">MB</span><span><b>MICROTECHNIQUE BUILDTECH</b><small>SMART REAL ESTATE SOLUTIONS</small></span></div><p>Discover property opportunities across India's cities, towns and villages.</p><div class="footerlinks">${links.map(([n,u])=>`<a href="${u}">${n}</a>`).join('')}<a href="/about">About</a><a href="/contact">Contact</a><a href="/register">Register</a></div><small>© ${new Date().getFullYear()} Microtechnique Buildtech. Verify property and legal details independently.</small></footer>`}
function layout(body){app.innerHTML=header()+body+footer();window.scrollTo(0,0)}
function pageHero(title,sub,crumb='Home'){return `<section class="pagehero"><div class="crumb"><a href="/">Home</a> / ${crumb}</div><h1>${title}</h1><div>${sub}</div></section>`}
function home(){layout(`<section class="hero"><div class="eyebrow">A BETTER WAY TO FIND PROPERTY</div><h1>Find Your <span>Dream Property</span></h1><p>Smart Real Estate Solutions for a Better Tomorrow.</p><p>✓ Property discovery across India &nbsp; ✓ Buyer, Owner & Builder tools</p><div class="searchbox"><div class="tabs">${links.slice(0,5).map(([n,u],i)=>`<a class="${i===0?'active':''}" href="${u}">${n}</a>`).join('')}</div><form id="homeSearch" class="searchgrid"><input name="city" placeholder="City (e.g. Surat)"><input name="locality" placeholder="Locality / Village"><select name="category"><option value="">All property types</option><option>Apartment</option><option>Villa</option><option>Residential Plot</option><option>Office Space</option><option>Shop</option></select><input name="min" type="number" placeholder="Budget min"><input name="max" type="number" placeholder="Budget max"><select name="bhk"><option value="">Any BHK</option>${[1,2,3,4,5].map(n=>`<option>${n}</option>`).join('')}</select><button>Search Properties →</button></form></div></section><div class="stats"><div class="stat"><b>India</b><small>Search coverage</small></div><div class="stat"><b>Multiple</b><small>Property categories</small></div><div class="stat"><b>0%</b><small>Brokerage promise only where applicable</small></div></div><section class="container"><div class="sectionhead"><div><div class="eyebrow">EXPLORE PROPERTY</div><h2>Find a place that feels like home</h2><p class="muted">Explore residential and commercial opportunities across India.</p></div><a href="/properties">View all properties →</a></div><div class="grid four">${[['🏢','Apartments & Flats','/buy'],['🏡','Villas & Houses','/buy'],['📐','Residential Plots','/plots'],['🏬','Commercial','/commercial']].map(x=>`<a class="category" href="${x[2]}"><span>${x[0]}</span><strong>${x[1]}</strong><small class="muted">Explore listings →</small></a>`).join('')}</div></section><section class="container" style="background:var(--bg);max-width:none"><div style="max-width:1240px;margin:auto"><div class="sectionhead"><div><div class="eyebrow">CURATED FOR YOU</div><h2>Featured properties</h2><p class="muted">Demonstration listings are clearly labelled.</p></div><a href="/properties">Browse all →</a></div><div id="featured" class="grid">Loading listings…</div></div></section><section class="container loanband"><div class="eyebrow">HOME FINANCE</div><h2>Planning a home loan?</h2><p>Estimate your EMI and submit an enquiry for follow-up.</p><a class="btn" href="/home-loans">Explore Home Loans</a></section><section class="container"><div class="eyebrow">MORE THAN PROPERTY SEARCH</div><h2>Services for your next move</h2><div class="grid four">${['Home Interiors','Construction & Renovation','Legal Assistance','Packers & Movers'].map(n=>`<a class="category" href="/services"><strong>${n}</strong><small class="muted">Submit service enquiry →</small></a>`).join('')}</div></section><section class="container"><div class="panel"><h2>Are you a property owner or builder?</h2><p class="muted">Create an account to submit a listing for review.</p><a class="btn" href="/register">Register to list property</a></div></section>`);$('#homeSearch').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target),p=new URLSearchParams();for(const [k,v]of f)if(v)p.set(k,v);location.href='/buy?'+p.toString()};loadFeatured();}
function propertyCard(p){return `<article class="card"><div class="cardimg">🏠</div><div class="cardbody"><span class="badge">${p.title.startsWith('SAMPLE')?'SAMPLE DATA':esc(p.status||'LISTING')}</span><h3>${esc(p.title)}</h3><div class="price">${money(p.price)}</div><p class="muted">📍 ${esc([p.locality,p.city,p.state].filter(Boolean).join(', '))} · ${p.area||'—'} sq.ft · ${p.bhk||'—'} BHK</p><p class="muted">${esc(p.description||'Property details available on request')}</p><div class="cardfoot"><a class="btn secondary" href="/property/${p.id}">View details</a><button class="light" onclick="saveFav(${p.id})">♡ Save</button></div></div></article>`}
async function loadFeatured(){try{const d=await api('/api/properties');$('#featured').innerHTML=d.properties.slice(0,3).map(propertyCard).join('')||'<div class="empty">No approved listings yet.</div>'}catch{$('#featured').textContent='Unable to load listings.'}}
const configs={'/buy':['Buy Property','Explore residential properties for sale across India.','buy'],'/rent':['Rent Property','Find homes, apartments and commercial spaces for rent.','rent'],'/commercial':['Commercial Property','Discover offices, shops, warehouses and commercial spaces.','commercial'],'/plots':['Plots & Land','Explore residential, agricultural and commercial land.','plots'],'/new-projects':['New Projects','Discover new residential and commercial developments.','new-project'],'/pg':['PG & Co-living','Find paying guest and shared accommodation.','rent'],'/properties':['All Properties','Search available property listings across India.','']};
async function searchPage(path){const [title,sub,purpose]=configs[path];const params=new URLSearchParams(location.search);layout(`${pageHero(title,sub,title)}<main class="results-layout"><aside class="panel filters"><h3>Filters</h3><form id="filters"><div class="field"><label>Keyword</label><input name="q" value="${esc(params.get('q')||'')}" placeholder="Project, locality"></div>${[['state','State'],['district','District'],['city','City'],['village','Village'],['locality','Locality'],['pincode','PIN Code']].map(([n,l])=>`<div class="field"><label>${l}</label><input name="${n}" value="${esc(params.get(n)||'')}" placeholder="${l}"></div>`).join('')}<div class="field"><label>Property Type</label><select name="category"><option value="">All types</option>${['Apartment','Villa','Independent House','Residential Plot','Commercial Plot','Office Space','Shop','Warehouse'].map(x=>`<option ${params.get('category')===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="field"><label>Budget minimum (₹)</label><input name="min" type="number" value="${esc(params.get('min')||'')}"></div><div class="field"><label>Budget maximum (₹)</label><input name="max" type="number" value="${esc(params.get('max')||'')}"></div><div class="field"><label>BHK</label><select name="bhk"><option value="">Any</option>${[1,2,3,4,5].map(n=>`<option ${params.get('bhk')==n?'selected':''}>${n}</option>`).join('')}</select></div><button class="btn">Apply filters</button><a class="btn light" href="${path}">Clear filters</a></form></aside><section><div class="results-top"><div><b id="resultCount">Properties</b><div class="muted">Search results from the platform database</div></div><select id="sort"><option value="newest">Newest first</option><option value="low">Price: Low to High</option><option value="high">Price: High to Low</option><option value="area">Largest area</option></select></div><div id="results" class="propertylist"><div class="empty">Loading…</div></div></section></main>`);$('#filters').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target),p=new URLSearchParams();for(const[k,v]of f)if(v)p.set(k,v);location.href=path+'?'+p};$('#sort').onchange=loadResults;await loadResults();async function loadResults(){const p=new URLSearchParams(location.search);p.set('sort',$('#sort').value);if(purpose)p.set('purpose',purpose);try{const d=await api('/api/properties?'+p);$('#resultCount').textContent=`${d.properties.length} properties found`;$('#results').innerHTML=d.properties.map(propertyCard).join('')||'<div class="empty">No properties match these filters. Try changing your search.</div>'}catch(e){$('#results').innerHTML=`<div class="empty">${esc(e.message)}</div>`}}}
async function detail(id){try{const {property:p}=await api('/api/properties/'+id);layout(`${pageHero(esc(p.title),'Property overview','Properties / Details')}<main class="container"><div class="grid" style="grid-template-columns:1.3fr 1fr"><div class="cardimg" style="height:360px">🏠</div><div class="panel"><span class="badge">${p.title.startsWith('SAMPLE')?'SAMPLE DATA':'LISTING'}</span><h2>${esc(p.title)}</h2><div class="price">${money(p.price)}</div><p>📍 ${esc([p.locality,p.city,p.district,p.state,p.pincode].filter(Boolean).join(', '))}</p><p>${p.area||'—'} sq.ft · ${p.bhk||'—'} BHK · ${esc(p.category)}</p><p class="muted">${esc(p.description||'No description provided')}</p>${me?`<button onclick="enquire(${p.id})">Contact seller</button> <button class="secondary" onclick="visit(${p.id})">Schedule site visit</button>`:`<a class="btn" href="/login">Login to enquire</a>`}</div></div><div class="panel" style="margin-top:20px"><h3>Property information</h3><p>Purpose: ${esc(p.purpose)} · Furnishing: ${esc(p.furnishing||'Not specified')}</p><p>RERA: ${esc(p.rera_number||'Not provided')} ${p.rera_applicable?'(Applicable)':''}</p><p>Listing contact: ${esc(p.lister||'Platform user')} (${esc(p.lister_role||'')})</p></div></main>`)}catch(e){layout(`${pageHero('Property not found','This listing may be unavailable.')}<main class="container"><div class="empty">${esc(e.message)}</div></main>`)}}
function authPage(register=false){layout(`${pageHero(register?'Create your account':'Welcome back',register?'Join Microtechnique Buildtech':'Login to your account',register?'Register':'Login')}<main class="formwrap panel"><h1>${register?'Registration':'Login'}</h1><form id="authform">${register?`<div class="field"><label>Full name</label><input name="name" required></div><div class="field"><label>Mobile number</label><input name="phone"></div><div class="field"><label>Account type</label><select name="role"><option value="buyer">Buyer</option><option value="tenant">Tenant</option><option value="owner">Property Owner</option><option value="seller">Seller</option><option value="builder">Builder / Developer</option><option value="agent">Agent / Broker</option><option value="channel_partner">Channel Partner</option><option value="investor">Investor</option></select></div>`:''}<div class="field"><label>Email</label><input name="email" type="email" required></div><div class="field"><label>Password ${register?'(minimum 10 characters)':''}</label><input name="password" type="password" minlength="10" required></div><button class="btn">${register?'Create account':'Login'}</button></form><p class="muted">${register?'Already registered?':'New to Microtechnique Buildtech?'} <a href="${register?'/login':'/register'}">${register?'Login':'Create account'}</a></p><div class="notice">Email OTP, SMS OTP and password recovery require external email/SMS configuration before production.</div></main>`);$('#authform').onsubmit=async e=>{e.preventDefault();const b=Object.fromEntries(new FormData(e.target));try{const d=await api(register?'/api/register':'/api/login',{method:'POST',body:JSON.stringify(b)});me=d.user;toast('Account ready');location.href=me.role==='admin'?'/admin/dashboard':'/dashboard'}catch(x){toast(x.message)}}}
async function dashboard(adminMode=false){if(!me){location.href='/login';return}if(adminMode&&!['admin','super_admin'].includes(me.role)){layout(`${pageHero('Access denied','Administrator access is required.')}`);return}let data={};try{data=adminMode?await api('/api/admin/overview'):await api('/api/dashboard')}catch(e){toast(e.message)}const menu=adminMode?['Overview','Users','Properties','Enquiries','Loans','Services']:['Overview','My Properties','Favourites','My Enquiries','Post Property','Home Loans','Services'];const paths=adminMode?['/admin/dashboard','/admin/users','/admin/properties','/admin/enquiries','/admin/loans','/admin/services']:['/dashboard','/owner/properties','/dashboard/favourites','/dashboard/enquiries','/post-property','/home-loans','/services'];layout(`${pageHero(adminMode?'Administration':'My Dashboard',`Welcome, ${esc(me.name)} · ${esc(me.role)}`, 'Dashboard')}<main class="dashlayout"><aside class="panel side"><h3>${adminMode?'Admin Menu':'Account Menu'}</h3>${menu.map((n,i)=>`<a href="${paths[i]}">${n}</a>`).join('')}<a href="#" onclick="logout();return false">Logout</a></aside><section><div class="metricgrid">${Object.entries(data).filter(([k])=>typeof data[k]==='number').map(([k,v])=>`<div class="metric"><b>${v}</b><span>${k[0].toUpperCase()+k.slice(1)}</span></div>`).join('')||'<div class="metric"><b>Welcome</b><span>Account active</span></div>'}</div><div class="panel" style="margin-top:18px"><h2>${adminMode?'Platform overview':'Your account'}</h2><p class="muted">Use the menu to manage your account and platform activity.</p>${adminMode?'<p>Review pending property submissions before publishing. Sample listings are marked clearly.</p>':'<p>Keep your profile updated. Owners, sellers, builders and agents can submit properties for admin review.</p>'}</div></section></main>`)}
function postProperty(){if(!me){location.href='/login';return}layout(`${pageHero('Post a Property','Share your property details for review.','Post Property')}<main class="formwrap panel" style="max-width:760px"><h1>Property listing form</h1><form id="postform"><div class="grid" style="grid-template-columns:1fr 1fr"><div class="field"><label>Property title</label><input name="title" required></div><div class="field"><label>Purpose</label><select name="purpose"><option value="buy">For Sale</option><option value="rent">For Rent</option><option value="new-project">New Project</option></select></div><div class="field"><label>Category</label><select name="category">${['Apartment','Villa','Independent House','Residential Plot','Commercial Plot','Office Space','Shop','Warehouse','Agricultural Land','PG'].map(x=>`<option>${x}</option>`).join('')}</select></div><div class="field"><label>Price (₹)</label><input name="price" type="number" min="1" required></div><div class="field"><label>State</label><input name="state"></div><div class="field"><label>District</label><input name="district"></div><div class="field"><label>City / Town</label><input name="city" required></div><div class="field"><label>Village</label><input name="village"></div><div class="field"><label>Locality</label><input name="locality" required></div><div class="field"><label>PIN Code</label><input name="pincode"></div><div class="field"><label>Area (sq.ft)</label><input name="area" type="number"></div><div class="field"><label>BHK</label><input name="bhk" type="number"></div></div><div class="field"><label>Description</label><textarea name="description" rows="4"></textarea></div><div class="field"><label>Furnishing</label><select name="furnishing"><option>Unfurnished</option><option>Semi-furnished</option><option>Furnished</option></select></div><button>Submit for admin review</button></form><p class="notice">This starter accepts property details. Photo/document upload, ownership verification and RERA review need to be completed before production launch.</p></main>`);$('#postform').onsubmit=async e=>{e.preventDefault();try{const d=await api('/api/properties',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});toast(d.message);location.href='/dashboard'}catch(x){toast(x.message)}}}
function loans(){layout(`${pageHero('Home Loans','Plan your home finance and submit an enquiry.','Home Loans')}<main class="container"><div class="grid" style="grid-template-columns:1fr 1fr"><section class="panel"><h2>EMI Calculator</h2><div class="field"><label>Loan amount (₹)</label><input id="amt" type="number" value="4000000"></div><div class="field"><label>Annual interest rate (%)</label><input id="rate" type="number" value="8.5" step="0.1"></div><div class="field"><label>Tenure (years)</label><input id="years" type="number" value="20"></div><button onclick="calcEmi()">Calculate EMI</button><h2 id="emiout">Monthly EMI: —</h2></section><section class="panel"><h2>Loan enquiry</h2><form id="loanform"><div class="field"><label>Loan amount (₹)</label><input name="loan_amount" type="number" required></div><div class="field"><label>Property value (₹)</label><input name="property_value" type="number"></div><div class="field"><label>Monthly income (₹)</label><input name="income" type="number" required></div><div class="field"><label>Tenure (years)</label><input name="tenure_years" type="number" value="20"></div><button>Submit enquiry</button></form></section></div><p class="notice">EMI is an estimate only. Loan eligibility, rates and approval are determined by the lender. No bank integration is active in this starter.</p></main>`);$('#loanform').onsubmit=async e=>{e.preventDefault();try{const d=await api('/api/loans',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});toast(d.message)}catch(x){toast(x.message)}}}
window.calcEmi=()=>{const p=Number($('#amt').value),r=Number($('#rate').value)/1200,n=Number($('#years').value)*12,emi=r? p*r*Math.pow(1+r,n)/(Math.pow(1+r,n)-1):p/n;$('#emiout').textContent='Monthly EMI: '+money(Math.round(emi))};
function services(){layout(`${pageHero('Property Services','Request assistance for your property journey.','Services')}<main class="container"><div class="grid four">${['Home Interiors','Construction & Renovation','Legal Assistance','Property Valuation','Home Inspection','Property Management','Packers & Movers','Documentation Support'].map(x=>`<div class="category"><strong>${x}</strong><small class="muted">Enquiry available</small></div>`).join('')}</div><div class="formwrap panel"><h2>Request a service</h2><form id="serviceform"><div class="field"><label>Service</label><select name="service">${['Home Interiors','Construction & Renovation','Legal Assistance','Property Valuation','Home Inspection','Property Management','Packers & Movers','Documentation Support'].map(x=>`<option>${x}</option>`).join('')}</select></div><div class="field"><label>Name</label><input name="name" required></div><div class="field"><label>Phone</label><input name="phone" required></div><div class="field"><label>Details</label><textarea name="details"></textarea></div><button>Submit enquiry</button></form></div></main>`);$('#serviceform').onsubmit=async e=>{e.preventDefault();try{const d=await api('/api/services',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});toast(d.message);e.target.reset()}catch(x){toast(x.message)}}}
window.saveFav=async id=>{if(!me){location.href='/login';return}try{await api('/api/favourites/'+id,{method:'POST'});toast('Saved to favourites')}catch(e){toast(e.message)}};window.enquire=async id=>{const phone=prompt('Your phone number');if(!phone)return;try{const d=await api('/api/enquiries',{method:'POST',body:JSON.stringify({property_id:id,phone,message:'Please contact me about this property.'})});toast(d.message)}catch(e){toast(e.message)}};window.visit=async id=>{const date=prompt('Preferred visit date (YYYY-MM-DD)');if(!date)return;try{const d=await api('/api/visits',{method:'POST',body:JSON.stringify({property_id:id,visit_date:date})});toast(d.message)}catch(e){toast(e.message)}};window.logout=async()=>{await api('/api/logout',{method:'POST'});me=null;location.href='/'};
async function boot(){try{me=(await api('/api/me')).user}catch{}const p=location.pathname;if(p==='/')return home();if(configs[p])return searchPage(p);if(p==='/property/'+p.split('/')[2]&&p.split('/')[2])return detail(p.split('/')[2]);if(p==='/login')return authPage(false);if(p==='/register')return authPage(true);if(p==='/dashboard'||p.startsWith('/owner/')||p.startsWith('/builder/')||p.startsWith('/agent/'))return dashboard(false);if(p==='/admin/dashboard'||p.startsWith('/admin/'))return dashboard(true);if(p==='/post-property')return postProperty();if(p==='/home-loans'||p==='/emi-calculator')return loans();if(p==='/services')return services();if(p==='/about'||p==='/contact'){layout(`${pageHero(p==='/about'?'About Microtechnique Buildtech':'Contact Us',p==='/about'?'Smart real estate solutions for property discovery across India.':'Connect with the Microtechnique Buildtech team.',p.slice(1))}<main class="container"><div class="panel"><h2>${p==='/about'?'Our platform':'Send an enquiry'}</h2><p class="muted">Microtechnique Buildtech is designed to connect property seekers and property providers across India. Contact and support workflows can be configured for launch.</p><a class="btn" href="/register">Get started</a></div></main>`);return}layout(`${pageHero('Page not found','The requested page does not exist.')}<main class="container"><a class="btn" href="/">Return home</a></main>`)}boot();
