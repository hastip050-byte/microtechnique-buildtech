                <p><b>Admin Approval:</b> ${esc(p.admin_approval || 'pending')}</p>
                <p><b>Status:</b> ${esc(p.status || 'pending')}</p>

                ${p.status === 'pending' && p.owner_approval === 'approved' ? `
                  <button class="btn" data-admin-decision="${Number(p.id)}" data-status="approved">
